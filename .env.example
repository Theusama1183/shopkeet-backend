# Shopkeet — environment variables (no real values, commit-safe)
# Copy to .env and fill in locally. See docs/04-agent-build-spec.md §2.

# App connects as shopkeet_app (non-superuser, owns the tenant tables) so RLS
# actually binds — shopkeet is the superuser bootstrap role (bypasses RLS).
DATABASE_URL=postgres://shopkeet_app:shopkeet_app@localhost:5432/shopkeet?sslmode=disable
REDIS_URL=redis://localhost:6379
PORT=3001
JWT_SECRET=change-me
APP_BASE_DOMAIN=shopkeet.com

# Cloudflare R2 (S3-compatible object storage — not open source, used deliberately)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=shopkeet-media
R2_PUBLIC_URL=