{{define "content"}}
<!-- Back in Stock Email -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="text-align:center;padding-bottom:32px;">
      <div style="display:inline-block;width:72px;height:72px;border-radius:50%;background:#f59e0b;display:flex;align-items:center;justify-content:center;margin-bottom:24px;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 17l-5-5 5-5"/>
          <path d="M4 17l5-5-5-5"/>
          <path d="M12 2v20M12 22v-2"/>
        </svg>
      </div>
      <h1 style="margin:0 0 8px 0;font-size:28px;font-weight:700;color:#111827;letter-spacing:-0.02em;">Back in stock! 🎉</h1>
      <p style="margin:0;font-size:16px;color:#6b7280;">Great news &mdash; your favorite item is available again</p>
    </td>
  </tr>
  
  <tr>
    <td style="padding-bottom:24px;">
      <div style="background:#fefce8;border:1px solid #fde047;border-radius:12px;padding:24px;text-align:center;">
        <p style="margin:0 0 8px 0;font-size:14px;color:#854d0e;">The item you requested is now available</p>
        <h2 style="margin:0 0 16px 0;font-size:24px;font-weight:700;color:#111827;">{{.ProductName}}</h2>
        
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td align="center">
              <a href="{{.StoreURL}}" style="display:inline-block;background:#f59e0b;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;padding:14px 32px;border-radius:8px;text-align:center;">
                Shop now
              </a>
            </td>
          </tr>
        </table>
      </div>
    </td>
  </tr>
  
  <tr>
    <td style="padding-top:16px;">
      <p style="margin:0;font-size:14px;color:#6b7280;text-align:center;">This notification was sent because you subscribed to restock alerts for this item at {{.StoreName}}. <a href="mailto:{{.ReplyTo}}" style="color:#3b82f6;">Contact support</a> if you have questions.</p>
    </td>
  </tr>
</table>
{{end}}