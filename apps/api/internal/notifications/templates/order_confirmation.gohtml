{{define "content"}}
<!-- Order Confirmation Email -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="text-align:center;padding-bottom:32px;">
      <div style="display:inline-block;width:72px;height:72px;border-radius:50%;background:#059669;display:flex;align-items:center;justify-content:center;margin-bottom:24px;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
      </div>
      <h1 style="margin:0 0 8px 0;font-size:28px;font-weight:700;color:#111827;letter-spacing:-0.02em;">Order confirmed!</h1>
      <p style="margin:0;font-size:16px;color:#6b7280;">Thanks for your order, {{.CustomerName}}</p>
    </td>
  </tr>
  
  <tr>
    <td style="padding-bottom:24px;">
      <div style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:12px;padding:24px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td style="padding-bottom:16px;border-bottom:1px solid #e5e7eb;">
              <p style="margin:0 0 4px 0;font-size:14px;color:#6b7280;text-transform:uppercase;letter-spacing:0.05em;">Order number</p>
              <p style="margin:0;font-size:20px;font-weight:700;color:#111827;">{{.OrderID}}</p>
            </td>
            <td style="padding-bottom:16px;border-bottom:1px solid #e5e7eb;text-align:right;">
              <p style="margin:0 0 4px 0;font-size:14px;color:#6b7280;text-transform:uppercase;letter-spacing:0.05em;">Total</p>
              <p style="margin:0;font-size:20px;font-weight:700;color:#111827;">{{.TotalFormatted}}</p>
            </td>
          </tr>
          <tr>
            <td style="padding-top:16px;">
              <p style="margin:0 0 4px 0;font-size:14px;color:#6b7280;text-transform:uppercase;letter-spacing:0.05em;">Payment status</p>
              <p style="margin:0;font-size:16px;font-weight:600;color:#059669;">Paid</p>
            </td>
            <td style="padding-top:16px;text-align:right;">
              <p style="margin:0 0 4px 0;font-size:14px;color:#6b7280;text-transform:uppercase;letter-spacing:0.05em;">Currency</p>
              <p style="margin:0;font-size:16px;font-weight:600;color:#111827;">{{.Currency}}</p>
            </td>
          </tr>
        </table>
      </div>
    </td>
  </tr>
  
  <tr>
    <td style="padding-bottom:24px;">
      <p style="margin:0 0 12px 0;font-size:14px;color:#6b7280;text-transform:uppercase;letter-spacing:0.05em;">Items in your order</p>
      {{.ItemsHTML}}
    </td>
  </tr>
  
  <tr>
    <td>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td align="center">
            <a href="{{.OrderURL}}" style="display:inline-block;background:#111827;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;padding:14px 32px;border-radius:8px;text-align:center;">
              View order details
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  
  <tr>
    <td style="padding-top:24px;">
      <p style="margin:0;font-size:14px;color:#6b7280;text-align:center;">We&rsquo;ll send you another email when your order ships. Questions? <a href="mailto:{{.ReplyTo}}" style="color:#3b82f6;">Contact support</a></p>
    </td>
  </tr>
</table>
{{end}}