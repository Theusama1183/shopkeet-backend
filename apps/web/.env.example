# --- Shopkeet web ---
# Copy to `.env.local` (gitignored) and adjust.

# Base URL of the Shopkeet Go API, including the /api/v1 prefix.
# lib/api.ts falls back to this default when unset.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Root domain that tenant subdomains, auth, and admin are all under
# (lib/domains.ts + lib/session.ts). Examples:
#   shopkeet.dev     -> admin.shopkeet.dev, auth.shopkeet.dev, {tenant}.shopkeet.dev
#   localhost        -> admin.localhost:3000 (works in dev)
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# Secret shared with the Go API — must match JWT_SECRET there so admin
# requests Bearer tokens parse. Signal: changing it invalidates every session.
JWT_SECRET=change-me

# Session cookie domain. With shared-auth across admin./auth./{tenant}. you want
# a parent domain cookie, e.g. .shopkeet.dev (note the leading dot) or just
# localhost in dev.
SESSION_COOKIE_DOMAIN=localhost

# The /dev/components QA gallery is reachable in `next dev` only unless this
# is explicitly set to "true". Leave it unset/uncommented for production.
NEXT_PUBLIC_ENABLE_DEV_GALLERY=true