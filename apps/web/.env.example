# --- Shopkeet web ---
# Copy to `.env.local` (gitignored) and adjust.

# Base URL of the Shopkeet Go API, including the /api/v1 prefix.
# lib/api.ts falls back to this default when unset.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# The /dev/components QA gallery is reachable in `next dev` only unless this
# is explicitly set to "true". Leave it unset/uncommented for production.
NEXT_PUBLIC_ENABLE_DEV_GALLERY=true