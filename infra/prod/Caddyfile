# Shopkeet — public edge. api.shopkeet.com terminates TLS (Let's Encrypt via
# Caddy auto-HTTPS) and reverse-proxies to the Go API on the compose network.
# /metrics is deliberately NOT proxied publicly (Observability §Platform) —
# Prometheus scrapes it directly at api:3001 on the internal network.
api.shopkeet.com {
	handle /metrics {
		respond "Forbidden" 403
	}
	handle {
		reverse_proxy api:3001
	}
}

# Coolify dashboard (dev VPS only) — Coolify UI listens on host port 8000;
# reaching it via host.docker.internal requires extra_hosts host-gateway on
# the caddy service (see docker-compose.yml).
coolify.shopkeet.com {
	reverse_proxy host.docker.internal:8000
}