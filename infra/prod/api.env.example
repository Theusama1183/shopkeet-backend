# Shopkeet production environment — copy to api.env and fill in real secrets.
# NEVER commit api.env (gitignore: *.env).
JWT_SECRET=<generate: 48 random hex chars, e.g. openssl rand -hex 24>
APP_BASE_DOMAIN=shopkeet.com
METRICS_TOKEN=<generate: 24 random hex chars, e.g. openssl rand -hex 12>
# R2 media (optional, uncomment to enable /media routes)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=